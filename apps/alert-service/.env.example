NODE_ENV=development
PORT=3006
TZ=Africa/Casablanca

# PostgreSQL (base dédiée au service — format URL comme les autres services)
DATABASE_URL=postgresql://notify_user:notify_dev_pass@localhost:5432/notification_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT (validation locale du token — même secret que l'auth-service)
JWT_SECRET=CHANGE_ME_JWT_SECRET_32_CHARS

# Sécurité inter-services (header X-Internal-Token sur /internal/*)
# Vide en dev : l'isolation réseau Docker suffit
INTERNAL_TOKEN=

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=alert-service
KAFKA_GROUP_ID=alert-service-group
KAFKA_RECOMMENDATIONS_TOPIC=recommendations-generated
KAFKA_TOPIC_DLQ=alerts-dlq
KAFKA_OUTBOUND_TOPIC=alerts-outbound
KAFKA_CONSUMER_ENABLED=true

# Farm service (résolution parcelle → propriétaire pour le flux Kafka)
FARM_SERVICE_URL=http://farm-service:3003
FARM_SERVICE_TIMEOUT_MS=5000

# Règle stress hydrique critique (politique de notification, pas du ML)
HYDRIC_STRESS_PROBABILITY_THRESHOLD=0.75
HYDRIC_STRESS_SOIL_HUMIDITY_MAX_PCT=25

# Déduplication : fenêtre glissante par (user, parcelle, type) en heures
DEDUP_WINDOW_HOURS=24

# Firebase Cloud Messaging (toutes vides → canal FCM désactivé, mode in-app uniquement)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# CORS
CORS_ORIGINS=http://localhost:3000
