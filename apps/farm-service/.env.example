# FARM-SERVICE — Variables d'environnement
# ============================================================
# Copiez ce fichier vers .env et remplissez les valeurs.
# En production : utilisez un gestionaire de secrets (Vault, AWS Secrets Manager, etc.)

# --- Application ---
PORT=3003
NODE_ENV=development

# --- Base de données PostgreSQL (farm_db) ---
# Format 1 : DATABASE_URL (recommandé pour Docker Compose)
DATABASE_URL=postgresql://farm_user:farm_dev_pass@postgres:5432/farm_db

# Format 2 : Variables individuelles (pour développement local)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
FARM_DB_USER=farm_user
FARM_DB_PASSWORD=farm_dev_pass
FARM_DB_NAME=farm_db

# --- Auth Service (appel HTTP inter-services) ---
AUTH_SERVICE_URL=http://auth-service:3001

# --- JWT (doit être identique à celui utilisé par auth-service) ---
JWT_SECRET=change_me_in_production_use_32_chars_minimum

# --- CORS (origines autorisées, séparées par des virgules) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
