# ============================================
# AL KATRA BEL QATRA — Variables d'Environnement
# Copier ce fichier en .env
# NE JAMAIS committer .env dans git !
# ============================================

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=alkatra_postgres_pass
POSTGRES_DB=alkatra_db
POSTGRES_PORT=5432

# PostgreSQL multi-database passwords
AUTH_DB_PASSWORD=auth_dev_pass
FARM_DB_PASSWORD=farm_dev_pass
RECOMMENDATION_DB_PASSWORD=recommendation_dev_pass
NOTIFY_DB_PASSWORD=notify_dev_pass
KEYCLOAK_DB_PASSWORD=keycloak_dev_pass
MLFLOW_DB_PASSWORD=mlflow_dev_pass

# MongoDB
MONGO_USER=alkatra
MONGO_PASSWORD=alkatra_mongo_change_me

# Redis
REDIS_PASSWORD=alkatra_redis_change_me

# MQTT (dev: laisser vide pour allow_anonymous)
MQTT_USER=
MQTT_PASSWORD=

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=alkatra_grafana_change_me

# Keycloak (placeholder Phase 1)

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=alkatra_keycloak_admin_change_me
KEYCLOAK_CLIENT_ID=alkatra-web
KEYCLOAK_CLIENT_SECRET=alkatra_keycloak_client_secret_change_this
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=alkatra


# Infobip SMS (Phase 1 — laisser vide en M0)
INFOBIP_API_KEY=your_infobip_api_key_here
INFOBIP_BASE_URL=https://api.infobip.com
INFOBIP_SENDER=AlKatra

# Firebase (Phase 1 — laisser vide en M0)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5001

# Open-Meteo (gratuit, pas de clé requise)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

NODE_ENV=development

ALKATRA_CLASSIFIER_MODEL_PATH="Chemin/vers/votre/model_classification_xgb.json"
ALKATRA_REGRESSOR_MODEL_PATH="Chemin/vers/votre/model_regression_xgb.json"
ALKATRA_BIAS_MODEL_PATH="Chemin/vers/votre/model_bias_xgb.json"


# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=2592000


# auth-service
AUTH_SERVICE_PORT=3001
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_BLOCK_DURATION_SECONDS=1800





