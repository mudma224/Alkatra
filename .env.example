# ============================================
# AL KATRA BEL QATRA — Variables d'Environnement
# Copier ce fichier en .env
# NE JAMAIS committer .env dans git !
# ============================================

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=alkatra_postgres_pass
POSTGRES_DB=alkatra_db
POSTGRES_PORT=5432

# PostgreSQL multi-database passwords
AUTH_DB_PASSWORD=auth_dev_pass
FARM_DB_PASSWORD=farm_dev_pass
RECOMMENDATION_DB_PASSWORD=recommendation_dev_pass
NOTIFY_DB_PASSWORD=notify_dev_pass
KEYCLOAK_DB_PASSWORD=keycloak_dev_pass
MLFLOW_DB_PASSWORD=mlflow_dev_pass
# Rôle lecture-seule (pg_monitor) pour postgres-exporter
POSTGRES_EXPORTER_PASSWORD=postgres_exporter_change_me

# MongoDB
MONGO_USER=alkatra
MONGO_PASSWORD=alkatra_mongo_change_me
MONGODB_URI=mongodb://alkatra:alkatra_mongo_change_me@mongodb:27017/alkatra_iot?authSource=admin

# Redis
REDIS_PASSWORD=alkatra_redis_change_me

# MQTT (dev: laisser vide pour allow_anonymous)
MQTT_USER=
MQTT_PASSWORD=

# Grafana — OBLIGATOIRE (le compose refuse de démarrer sans valeur)
GRAFANA_USER=admin
GRAFANA_PASSWORD=alkatra_grafana_change_me

# ============================================
# Observabilité — Alertmanager (emails d'alertes infra)
# Dev : MailHog (SMTP sur 1025, UI de vérification sur http://localhost:8025)
# Prod : SMTP réel + activer require_tls dans infra/alertmanager/alertmanager.yml.template
# ============================================
ALERT_SMTP_HOST=mailhog
ALERT_SMTP_PORT=1025
ALERT_EMAIL_FROM=alertmanager@alkatra.local
ALERT_EMAIL_TO=dev-team@alkatra.local

# Keycloak (placeholder Phase 1)

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=alkatra_keycloak_admin_change_me
KEYCLOAK_CLIENT_ID=alkatra-web
KEYCLOAK_CLIENT_SECRET=alkatra_keycloak_client_secret_change_this
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=alkatra


# Infobip SMS (Phase 1 — laisser vide en M0)
INFOBIP_API_KEY=your_infobip_api_key_here
INFOBIP_BASE_URL=https://api.infobip.com
INFOBIP_SENDER=AlKatra

# Firebase (Phase 1 — laisser vide en M0)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5001
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_change_me

# Open-Meteo (gratuit, pas de clé requise)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

NODE_ENV=development

ALKATRA_CLASSIFIER_MODEL_PATH="Chemin/vers/votre/model_classification_xgb.json"
ALKATRA_REGRESSOR_MODEL_PATH="Chemin/vers/votre/model_regression_xgb.json"
ALKATRA_BIAS_MODEL_PATH="Chemin/vers/votre/model_bias_xgb.json"


# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=2592000


# auth-service
AUTH_SERVICE_PORT=3001
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_BLOCK_DURATION_SECONDS=1800


# ============================================
# farm-service (Sprint 2)
# ============================================
FARM_SERVICE_PORT=3003
AUTH_SERVICE_URL=http://auth-service:3001
ALERT_SERVICE_URL=http://alert-service:3006

# ============================================
# Sécurité inter-services (Sprint 5)
# Header X-Internal-Token sur les endpoints /internal/* — vide en dev
# (l'isolation réseau Docker suffit)
# ============================================
INTERNAL_TOKEN=

# ============================================
# Santé capteurs — farm-service (modifiables à tout moment + redémarrage)
# inactive : silence > N heures → capteur « désactivé » + notification légère (info)
# failing  : silence > N heures → capteur « défaillant » + alerte rouge (critical)
# (SENSOR_INACTIVE_HOURS doit rester strictement inférieur à SENSOR_FAILING_HOURS)
# ============================================
SENSOR_INACTIVE_HOURS=2
SENSOR_FAILING_HOURS=24
SENSOR_ACTIVITY_CHECK_INTERVAL_MINUTES=15

# ============================================
# alert-service — Sprint 5 (notifications)
# ============================================
ALERT_SERVICE_PORT=3006
# Seuil d'alerte batterie capteur faible (%) — émis par farm-service
LOW_BATTERY_THRESHOLD=20
# Règle stress hydrique critique (consumer recommendations-generated)
HYDRIC_STRESS_PROBABILITY_THRESHOLD=0.75
HYDRIC_STRESS_SOIL_HUMIDITY_MAX_PCT=25
# Déduplication des alertes : fenêtre glissante (heures) par (user, parcelle, type)
DEDUP_WINDOW_HOURS=24

# ============================================
# Services Kafka / ML / gateway
# ============================================
KAFKA_BROKERS=kafka:9092
KAFKA_INPUT_TOPIC=processed-sensor-data
KAFKA_OUTPUT_TOPIC=recommendations-generated
KAFKA_CLIENT_ID=recommendation-service
KAFKA_GROUP_ID=recommendation-sync-group
KAFKA_RECOMMENDATIONS_TOPIC=recommendations-generated
KAFKA_TOPIC_DLQ=recommendations-generated-dlq
KAFKA_OUTBOUND_TOPIC=alerts-outbound
KAFKA_CONSUMER_ENABLED=true
KAFKA_STARTING_OFFSETS=latest
KAFKA_FAIL_ON_DATA_LOSS=false
SPARK_DRY_RUN=0
PUSHGATEWAY_URL=http://pushgateway:9091
MLFLOW_CLASSIFIER_NAME=AlKatra-Classifier
MLFLOW_REGRESSOR_NAME=AlKatra-Regressor
MLFLOW_MODEL_STAGE=Production
CLASSIFICATION_THRESHOLD=0.35
ENABLE_KAFKA_CONSUMER=true
ENABLE_KAFKA_PRODUCER=true
MONGO_DB=alkatra_iot
MONGO_RECO_COLLECTION=irrigation_recommendations

# ============================================
# Gateway et services applicatifs
# ============================================
AUTH_SERVICE_HOST=auth-service
USER_SERVICE_HOST=user-service
USER_SERVICE_PORT=3002
FARM_SERVICE_HOST=farm-service
RECOMMENDATION_SERVICE_HOST=recommendation-service
RECOMMENDATION_SERVICE_PORT=3004
ALERT_SERVICE_HOST=alert-service
ALERT_SERVICE_PORT=3006
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# recommendation-service — Sprint 3
# =============================================================================
RECOMMENDATION_DB_PASSWORD=recommendation_dev_pass
RECOMMENDATION_SERVICE_PORT=3004