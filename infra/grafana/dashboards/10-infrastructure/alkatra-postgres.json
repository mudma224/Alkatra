{
  "uid": "alkatra-postgres",
  "title": "Al Katra — PostgreSQL",
  "tags": ["alkatra", "infra", "postgres"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "description": "PostgreSQL 16 multi-bases (auth_db, farm_db, recommendation_db, notification_db, keycloak_db, mlflow_db) via postgres-exporter (rôle pg_monitor).",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Statut exporter",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [ { "refId": "A", "expr": "max(pg_up)", "legendFormat": "pg_up" } ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Connexions / max",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "description": "Alerte à 85 % (règle PostgresConnectionsHigh).",
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "red", "value": 0.85 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [ { "refId": "A", "expr": "sum(pg_stat_activity_count) / clamp_min(pg_settings_max_connections, 1)", "legendFormat": "usage" } ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Transactions/s (commit)",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [ { "refId": "A", "expr": "sum(rate(pg_stat_database_xact_commit[5m]))", "legendFormat": "commit/s" } ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rollbacks/s",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [ { "refId": "A", "expr": "sum(rate(pg_stat_database_xact_rollback[5m]))", "legendFormat": "rollback/s" } ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Connexions actives par base",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [ { "refId": "A", "expr": "sum by (datname) (pg_stat_activity_count{datname!~\"\"})", "legendFormat": "{{datname}}" } ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Taille des bases",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [ { "refId": "A", "expr": "pg_database_size_bytes{datname!~\"template0|template1\"}", "legendFormat": "{{datname}}" } ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Deadlocks / annulations par base",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [
        { "refId": "A", "expr": "rate(pg_stat_database_deadlocks[5m])", "legendFormat": "deadlocks {{datname}}" },
        { "refId": "B", "expr": "rate(pg_stat_database_conflicts[5m])", "legendFormat": "conflicts {{datname}}" }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Temps de réponse des disques (avg)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [ { "refId": "A", "expr": "rate(pg_stat_bgwriter_checkpoint_write_time[5m]) / 1000", "legendFormat": "checkpoint write (s/s)" } ]
    }
  ]
}
