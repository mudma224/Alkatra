{
  "id": null,
  "uid": "alkatra-ml-inference",
  "title": "Al Katra - ML Inference",
  "tags": ["alkatra", "ml", "inference"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Predictions / min",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(ml_predictions_total[1m])) * 60",
          "legendFormat": "predictions/min"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Predictions total",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(ml_predictions_total)",
          "format": "time_series"
        }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "Kafka messages / min (status)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (status) (rate(ml_kafka_messages_total[1m])) * 60",
          "legendFormat": "{{status}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "Missing features (increase / 5m)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(increase(ml_missing_features_total[5m])) by (feature)",
          "legendFormat": "{{feature}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "id": 5,
      "title": "Prediction latency (avg seconds)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(ml_prediction_latency_seconds_sum[1m]) / rate(ml_prediction_latency_seconds_count[1m])",
          "legendFormat": "avg(s)"
        }
      ],
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 16 }
    },
    {
      "id": 6,
      "title": "ML Service up",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "up{job=~\"ml-inference-service\"}",
          "legendFormat": "up"
        }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 }
    }
  ]
}
