# Template Alertmanager — rendu par entrypoint.sh (envsubst), même convention
# que la gateway Nginx (ADR-0002 : --env-file .env explicite).
#
# Variables : ALERT_SMTP_HOST, ALERT_SMTP_PORT, ALERT_EMAIL_FROM, ALERT_EMAIL_TO
# Dev  : mailhog:1025 (UI de vérification sur http://localhost:8025)
# Prod : SMTP réel + require_tls (changer les variables d'environnement).
global:
  resolve_timeout: 1m
  smtp_smarthost: '${ALERT_SMTP_HOST}:${ALERT_SMTP_PORT}'
  smtp_from: '${ALERT_EMAIL_FROM}'
  smtp_require_tls: false

route:
  receiver: email-dev
  group_by: ['alertname', 'job']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Les alertes critiques sont re-notifiées plus fréquemment.
    - matchers:
        - severity="critical"
      receiver: email-dev
      repeat_interval: 1h

# Une alerte critique inhibe la warning équivalente (même alertname/job)
# pour éviter le double email.
inhibit_rules:
  - source_matchers:
      - severity="critical"
    target_matchers:
      - severity="warning"
    equal: ['alertname', 'job']

receivers:
  - name: email-dev
    email_configs:
      - to: '${ALERT_EMAIL_TO}'
        send_resolved: true
        headers:
          Subject: '[AL-KATRA] {{ .CommonLabels.alertname }} — {{ if eq .Status "firing" }}FIRING{{ else }}RESOLVED{{ end }} ({{ .Alerts | len }})'
