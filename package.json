{
  "name": "alkatra-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Al Katra Bel Qatra — Smart Irrigation IoT+AI Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "docker:reset": "docker compose -f infra/docker/docker-compose.yml down -v && npm run docker:up",
    "simulate": "node scripts/simulate-sensor.js",
    "health": "bash scripts/health-check.sh",
    "setup": "bash scripts/setup.sh",
    "models:register": "python3 scripts/register-models.py"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}